__pycache__/
*.pyc
.venv/
venv/
backend/.env
backend/sentinel.db
# SQLite write-ahead log sidecars — regenerated next to the database itself
backend/sentinel.db-shm
backend/sentinel.db-wal
# Telegram/X/Instagram/Facebook login state — full account access, same as a password
backend/*.session
backend/*.session-journal
backend/x_cookies.json
backend/ig_session.json
backend/fb_cookies.json
# Accounts the crawlers found for themselves (crawlers/roster.py) — deployment
# state, not source. Rebuilt by `python -m app.crawlers.facebook_discover` and
# by the Instagram collector's own location/search legs.
backend/discovered_accounts.json
# the crawler's persistent Chrome profile — holds the live Facebook session
backend/.fb_profile/
backend/reports/*.pdf
backend/reports/*.xlsx
backend/app/ml/models/
# local neural voice weights (~336 MB) — one command brings them back:
#   cd backend && python -m app.services.voice.bootstrap
backend/models/
backend/app/ml/eval_report.json
backend/app/ml/sentiment_eval_report.json
backend/app/ml/baseline_report.json
# raw public datasets (hundreds of MB) — one command brings everything back:
#   cd backend && python -m app.ml.bootstrap
backend/app/data/datasets/**
!backend/app/data/datasets/README.md
# Third-party projects read while building the voice stack — ~190 MB of other
# people's repositories, downloaded for reference and vendored into nothing.
# What was actually taken from them lives in our own files and is credited in
# their docstrings (pipecat's Kokoro/Piper services, Rapida's streamer, Leon's
# local-intent-first design). Committing the sources themselves would put their
# licences and their history into this repo for no benefit.
agenticSeek-main/
leon-develop/
pipecat-main/
voice-ai-main/
instagram-user-feed-master/

node_modules/
frontend/dist/
frontend/.env.local
*.tsbuildinfo
.DS_Store
.playwright-mcp/

# Optional local Sherlock checkout. Only its data.json is used and a copy is
# bundled at backend/app/osint/resources/sherlock_data.json, so the 1.4 MB
# upstream tree does not belong in this repo. Drop the folder here to override
# the bundled manifest with a newer one.
sherlock-master/

# Reference face gallery (osint/face_gallery.py). The photos an operator drops
# in are their own material — often personal, always local — and the derived
# embeddings are biometric data, so neither belongs in the repo. The README
# stays so a fresh clone still explains what the folder is for.
backend/.face_gallery.json
backend/.lens_profile/
