# ── SENTINEL backend configuration ──────────────────────────────────────────
# With no .env at all, SENTINEL runs the demo: simulated multilingual
# ingestion + the fully-trained transformer NLP stack (NLP_MODE=full) + SQLite.

# Database (default: SQLite file next to the app; swap for Postgres in prod)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/sentinel
DATABASE_URL=

# Ingestion loop cadence (seconds between crawl ticks). Live platform adapters
# additionally respect CRAWL_MIN_INTERVAL_SECONDS below, so a fast tick only
# affects the simulator/UI — real APIs are never hammered.
INGEST_INTERVAL_SECONDS=4

# NLP engine: "full" (default — fine-tuned indic-bert threat classifier +
# CardiffNLP multilingual sentiment + multilingual toxicity; requires
# `pip install -r requirements-ml.txt`) or "lite" (lexicon+heuristics
# emergency fallback — full mode also degrades to it automatically if the
# transformer stack is missing, so the app can never break).
NLP_MODE=full

# Alerting thresholds on the 0-100 threat score (calibrated to the composite
# formula: confident amplified incitement lands ~72-80, inflammatory ~55-63)
ALERT_THRESHOLD=65
CRITICAL_THRESHOLD=74

# Simulated ingestion (the zero-key default). Set to false only if you have
# real platform keys below and want exclusively live data.
SIMULATION_ENABLED=true

# Deployment scope: the cities this instance monitors. Drives the default
# watchlist geo entries and text geo-tagging.
TARGET_CITIES=Surat,Ahmedabad,Vadodara,Rajkot

# Politeness floor (seconds) between successive calls to the SAME platform
# API. Never lower this aggressively: rapid-fire queries from one IP/app get
# rate-limited or blocked. Batch queries, then wait out the gap.
CRAWL_MIN_INTERVAL_SECONDS=300

# ── Real platform API keys (all optional; adapters activate when present) ──

# Facebook Graph API. FB_PAGE_IDS is the seed-page list: the top public pages
# per target city (news, civic bodies, community pages), page id or username,
# with an optional :City geo-tag.
# NOTE: reading pages you don't manage requires Meta's "Page Public Content
# Access" feature approved for your app; pages you manage work with a normal
# Page access token.
FB_ACCESS_TOKEN=
FB_API_VERSION=v21.0
# FB_PAGE_IDS=tv9gujarati:Ahmedabad,SuratMunicipalCorporation:Surat,VMCVadodara:Vadodara,RajkotUpdates:Rajkot
FB_PAGE_IDS=

# Instagram Graph API (via a Meta app + linked Instagram professional account).
# IG_BUSINESS_ACCOUNT_ID is YOUR linked IG business-account id — business
# discovery and hashtag search are namespaced under it. IG_SEED_USERNAMES are
# the public business/creator accounts to monitor per city.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
# IG_SEED_USERNAMES=suratsmartcity:Surat,amdavadamc:Ahmedabad,vmc_vadodara:Vadodara,rmc_rajkot:Rajkot
IG_SEED_USERNAMES=

# Reddit official OAuth API — create a "script" app at reddit.com/prefs/apps.
# REDDIT_SUBREDDITS are the seed subreddits (defaults to the 4 target-city
# subs + r/Gujarat), searched alongside the analyst watchlist.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentinel-osint/1.0
REDDIT_SUBREDDITS=Surat:Surat,ahmedabad:Ahmedabad,Vadodara:Vadodara,rajkot:Rajkot,Gujarat

# X API v2 recent search
X_BEARER_TOKEN=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Comma-separated RSS feeds for the generic web adapter (local news outlets)
RSS_FEEDS=
