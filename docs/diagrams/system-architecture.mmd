flowchart LR
    subgraph COLLECT["Collectors — one adapter per platform, politeness-gapped"]
        XA["X — API v2, else twikit"]
        RD["Reddit — OAuth, else PullPush"]
        TG["Telegram — MTProto, else t.me previews"]
        YT["YouTube — Data API v3 (+ comments)"]
        FB["Facebook — Graph, else logged-in browser"]
        IG["Instagram — Graph, else instagrapi,<br/>else signed-out web routes"]
        DISC["Discovery: page search, location feeds,<br/>account search → discovered_accounts.json"]
    end

    subgraph PIPE["NLP pipeline — ml/pipeline.py enrich()"]
        NORM["slang normalisation"]
        LID["language ID<br/>en · hi · gu · hinglish · gujlish · mixed"]
        CTX["context extraction<br/>TextContext + MetaContext"]
        M3["3 sentiment models<br/>MuRIL · TF-IDF+SVC · lexicon"]
        ENS["ensemble decision"]
        TOX["toxicity"]
        SCORE["concern score 0-100"]
        VERIFY["Groq second opinion<br/>can override, always recorded"]
    end

    subgraph INTEL["Intelligence"]
        TREND["trends + emerging terms"]
        NET["author network, clusters"]
        GEO["geo-tag: 4 target cities"]
        ALERT["alert bands + WhatsApp"]
        REPORT["PDF / XLSX reports"]
        OSINT["forensics: media, faces,<br/>usernames, campaigns"]
    end

    COLLECT --> NORM --> LID --> CTX --> M3 --> ENS --> TOX --> SCORE --> VERIFY
    VERIFY --> INTEL
    DB[("SQLite / Postgres — SQLModel<br/>append-only audit trigger")]
    API["FastAPI — REST + /ws/live + /ws/voice"]
    FE["React + Vite + TypeScript"]
    INTEL --> DB
    PIPE --> DB
    DB --> API --> FE
